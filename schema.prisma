datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model City {
  id     Int     @id @default(autoincrement())
  name   String
  girls  Girl[]
}

model Girl {
  id               Int            @id @default(autoincrement())
  name             String
  age              Int
  active           Boolean
  cityId           Int
  city             City           @relation(fields: [cityId], references: [id])
  specificLocation String
  phoneNumber      String
  description      String
  sessionPrices    Json           // Array of {price: number, duration: SessionDuration}
  oneHourPrice     Float
  ethnicity        String
  height           Int
  weight           Int
  chestCm          Int
  waistCm          Int
  bottomCm         Int
  services         Service[]      @relation("GirlServices")
  parking          Boolean
  schedule         Json           // Since Schedule is a complex object
  attributes       Json           // Since Attributes is a complex object
  images           String[]
  videos           String[]
  profilePicture   String
  editLevel        Int
  countryOfOrigin  String?
  user             User?          @relation(fields: [userId], references: [id])
  userId           Int?
  categories       GirlCategory[]
}

enum GirlCategory {
  Gold
  Silver
  Bronze
  Maduras
  Masajistas
  Barbie
}

model Service {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  girls       Girl[]  @relation("GirlServices")
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  role     UserRole
  girlId   Int?
  girl     Girl?   @relation(fields: [girlId], references: [id])
}

enum UserRole {
  admin
  girl
}
