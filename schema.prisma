datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model City {
  id    Int    @id @default(autoincrement())
  name  String
  girls Girl[]
}

model ClickStats {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  generalClicks Int      @default(0)
  clicksOnGirls Int      @default(0)
}

model GirlClickStats {
  id               Int      @id @default(autoincrement())
  girlId           Int
  date             DateTime @default(now())
  clicksToProfile  Int      @default(0)
  clciksToWhatsapp Int      @default(0)
}

model Girl {
  id               Int              @id @default(autoincrement())
  name             String
  bday             DateTime
  active           Boolean
  bluredFace       Boolean
  cityId           Int
  city             City             @relation(fields: [cityId], references: [id])
  specificLocation String
  phoneNumber      String
  description      String           @db.VarChar(550)
  ethnicity        String
  height           Int
  weight           Int
  chestCm          Int
  waistCm          Int
  bottomCm         Int
  services         Service[]        @relation("GirlServices")
  paidServices     Service[]        @relation("GirlPaidServices")
  paymentTier      String
  subscriptionId   Int?             @unique
  subscription     Subscription?    @relation(fields: [subscriptionId], references: [id])
  parking          Boolean
  schedule         Json
  attributes       Json
  images           Json
  videos           Json
  profilePicture   String
  editLevel        Int
  countryOfOrigin  String?
  categories       Json
  sessionPricesId  Int?             @unique
  sessionPrices    Prices?          @relation(fields: [sessionPricesId], references: [id])
  verificationId   Int?             @unique
  verification     Verification?    @relation(fields: [verificationId], references: [id])
}

model Prices {
  id                   Int    @id @default(autoincrement())
  halfHourPrice        Int?
  oneHourPrice         Int?
  oneAndAHalfHourPrice Int?
  twoHourPrice         Int?
  fourHourPrice        Int?
  dinnerPrice          Int?
  wholeNight           Int?
  girlId               Int?
  girl                 Girl?
}

model Service {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  girls       Girl[] @relation("GirlServices")
  paidGirls   Girl[] @relation("GirlPaidServices")
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  password        String
  role            UserRole
  girlId          Int?     @unique
  emailVerified   Boolean  @default(false)
  verificationCode String?  // Default is null
}

model Verification {
  id               Int                @id @default(autoincrement())
  carnetFrontal    String
  carnetAtras      String
  status           VerificationStatus
  name             String
  lastname         String
  bday             DateTime
  rut              String?
  verificationDate DateTime?
  verifiedBy       Int?               @unique // User ID
  girlId           Int?
  Girl             Girl?
}

model Subscription {
  id                Int                 @id @default(autoincrement())
  active            Boolean
  expiryDate        DateTime
  DeactivationDate  DateTime
  firstPause        Json
  secondPause       Json
  ThirdPause        Json
  girlId            Int?
  girl              Girl?
  payments          SubscriptionPayment[]
}


model SubscriptionPayment {
  id            Int       @id @default(autoincrement())
  subscriptionId Int
  paymentTier   String
  amountPaid    Int
  paymentDate   DateTime
  duration      String
  paymentMethod String
  Subscription  Subscription @relation(fields: [subscriptionId], references: [id])
}

model ClientReview {
  id          Int      @id @default(autoincrement())
  girlId      Int
  review      String   @db.VarChar(3000)
  phoneNumber String
  rating      Int
  client      Client   @relation(fields: [phoneNumber], references: [phoneNumber])
}

model Client {
  phoneNumber String  @id @unique
  clientReviews ClientReview[]
}

enum VerificationStatus {
  pending
  scheduled
  processing
  verified
}

enum UserRole {
  admin
  girl
}
