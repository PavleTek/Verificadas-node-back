datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model City {
  id    Int    @id @default(autoincrement())
  name  String
  girls Girl[]
}

model ClickStats {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  generalClicks Int      @default(0)
  clicksOnGirls Int      @default(0)
}

model GirlClickStats {
  id               Int      @id @default(autoincrement())
  girlId           Int
  date             DateTime @default(now())
  clicksToProfile  Int      @default(0)
  clciksToWhatsapp Int      @default(0)
}

model Girl {
  id               Int           @id @default(autoincrement())
  name             String
  bday             DateTime
  active           Boolean
  bluredFace       Boolean
  cityId           Int
  city             City          @relation(fields: [cityId], references: [id])
  specificLocation String
  phoneNumber      String
  description      String
  ethnicity        String
  height           Int
  weight           Int
  chestCm          Int
  waistCm          Int
  bottomCm         Int
  services         Service[]     @relation("GirlServices")
  parking          Boolean
  schedule         Json // Since Schedule is a complex object
  attributes       Json // Since Attributes is a complex object
  images           Json // Change to Json type
  videos           Json // Change to Json type
  profilePicture   String
  editLevel        Int
  countryOfOrigin  String?
  categories       Json // Change to Json type
  sessionPricesId  Int?          @unique
  sessionPrices    Prices?       @relation(fields: [sessionPricesId], references: [id])
  verificationId   Int?          @unique
  verification     Verification? @relation(fields: [verificationId], references: [id])
}

model Prices {
  id                   Int    @id @default(autoincrement())
  halfHourPrice        Int?
  oneHourPrice         Int?
  oneAndAHalfHourPrice Int?
  twoHourPrice         Int?
  fourHourPrice        Int?
  dinnerPrice          Int?
  wholeNight           Int?
  girlId               Int?
  girl                 Girl?
}

enum GirlCategory {
  Gold
  Silver
  Bronze
  Maduras
  Masajistas
  Barbie
}

model Service {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  girls       Girl[] @relation("GirlServices")
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  password        String
  role            UserRole
  girlId          Int?     @unique
  emailVerified   Boolean  @default(false)
  verificationCode String?  // Default is null
}

model Verification {
  id               Int                @id @default(autoincrement())
  carnetFrontal    String
  carnetAtras      String
  status           VerificationStatus
  name             String
  lastname         String
  bday             DateTime
  rut              String?
  verificationDate DateTime?
  verifiedBy       Int?               @unique // User ID
  girlId           Int?
  Girl             Girl?
}

enum VerificationStatus {
  pending
  scheduled
  procesing
  verified
}

enum UserRole {
  admin
  girl
}
